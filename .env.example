# ===========================================================================
# AI LANDING STUDIO - Variables de entorno
# Copia este archivo como `.env.local` y rellena los valores que necesites.
# NINGUNA de las claves *_API_KEY se expone al navegador: solo se leen en
# el servidor (route handlers dentro de src/app/api).
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. SUPABASE (opcional en desarrollo)
# Si se dejan vacias, la aplicacion arranca con el DataStore local en disco
# (.data/) y un usuario demo. Ver docs/DATABASE.md.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Necesaria unicamente para tareas administrativas/seed.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexion directa a PostgreSQL. La usa UNICAMENTE el script
# `npm run db:setup`, que crea las tablas, las politicas RLS y el catalogo.
# La aplicacion no la necesita.
# Panel de Supabase -> Project Settings -> Database -> Connection string -> URI
# Sustituye [YOUR-PASSWORD] por la contrasena SIN los corchetes, y codifica
# los caracteres especiales para URL (@ -> %40, # -> %23).
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# 2. PROVEEDORES LLM (todos opcionales)
# Sin ninguna clave, la aplicacion usa el Mock Provider y lo indica en la UI.
#
# Cada usuario tambien puede pegar sus claves en Ajustes (Gemini, Groq, URL de
# Ollama y credenciales de Cloudflare): se guardan CIFRADAS y solo para su
# cuenta. Las de este archivo son el respaldo compartido del servidor: una clave
# guardada en Ajustes gana a la de aqui, y sin ella se usa la de aqui.
# ---------------------------------------------------------------------------
# Clave con la que se cifran las claves guardadas desde Ajustes. OPCIONAL: sin
# ella se genera una en .data/credentials.key (no la subas ni la borres). Pon una
# propia (32+ caracteres aleatorios) si despliegas en un sitio sin disco
# escribible, o si quieres que la base de datos y la clave vivan separadas.
# Si la cambias, las claves guardadas dejan de poder leerse y hay que volver a
# escribirlas.
CREDENTIALS_ENCRYPTION_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Usa el alias `-latest` para no quedarte fijado a un modelo retirado.
GEMINI_DEFAULT_MODEL=gemini-flash-latest

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

# Ollama corre en local: no necesita clave. Instala Ollama
# (https://ollama.com/download), descarga un modelo con
# `ollama pull <modelo>` y deja OLLAMA_BASE_URL vacio para usar
# http://localhost:11434.
OLLAMA_BASE_URL=
OLLAMA_DEFAULT_MODEL=qwen3:8b

# Proveedor por defecto: mock | gemini | groq | ollama
DEFAULT_LLM_PROVIDER=mock

# ---------------------------------------------------------------------------
# 3. GENERACION DE IMAGENES (opcional)
# Las usa la tecnica de diseno "Generacion de imagenes": el LLM deja marcadores
# <img data-ai-image="..."> y el servidor los rellena con FLUX. Sin estas dos
# variables la tecnica deja los marcadores con la descripcion de cada imagen.
# Panel de Cloudflare -> Workers AI -> "Use REST API" -> Create a Workers AI
# API Token (permisos Workers AI Read y Edit) y copia el Account ID.
# Guia: https://developers.cloudflare.com/workers-ai/get-started/rest-api/
# Capa gratuita: 10 000 neuronas al dia (~173 imagenes: schnell devuelve JPEG de 1024x1024).
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Modelo (FLUX.1 schnell, Apache-2.0). FLUX.2 usa multipart y no esta soportado.
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Imagenes que se generan por pagina (el resto queda como marcador pendiente)
IMAGE_MAX_PER_LANDING=4
# Pasos de difusion de schnell (maximo 8; 4 es su valor por defecto)
IMAGE_STEPS=4
# Timeout por imagen (ms) y tiempo maximo de TODO el paso de imagenes (ms)
IMAGE_TIMEOUT_MS=30000
IMAGE_STEP_BUDGET_MS=45000
# Imagenes por usuario y hora
IMAGE_RATE_LIMIT_PER_HOUR=30
# Tras un 429 de "cuota diaria agotada", no se vuelve a llamar a Cloudflare
# durante este tiempo (ms)
IMAGE_QUOTA_COOLDOWN_MS=600000
# Tras no poder GUARDAR una imagen recien generada (p. ej. Supabase sin ejecutar
# `npm run db:setup`), no se vuelve a llamar a Cloudflare durante este tiempo (ms)
IMAGE_STORAGE_COOLDOWN_MS=60000
# Solo para pruebas (scripts/stub-cloudflare.mjs). Se ignora si no es https ni
# http://localhost.
# CLOUDFLARE_API_BASE_URL=

# ---------------------------------------------------------------------------
# 4. LIMITES Y TIEMPOS
# ---------------------------------------------------------------------------
# Timeout por peticion al LLM (ms). Generar una landing completa con un modelo
# grande puede superar los 70 s, asi que no lo bajes demasiado.
LLM_TIMEOUT_MS=90000
# Numero maximo de generaciones por usuario y ventana
RATE_LIMIT_MAX_REQUESTS=20
# Ventana del rate limit (ms)
RATE_LIMIT_WINDOW_MS=3600000
# Enfriamiento minimo entre generaciones del mismo usuario (ms)
RATE_LIMIT_COOLDOWN_MS=3000
