{
  "name": "ai-landing-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de ingenieria de prompts y generacion de Landing Pages mediante LLM.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --env-file-if-exists=.env.local scripts/db-setup.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/db-setup.mjs --check",
    "seed:sql": "node --experimental-strip-types --no-warnings scripts/generate-seed-sql.mjs",
    "verify:flow": "node scripts/verify-flow.mjs",
    "verify:inspector": "node --experimental-strip-types --no-warnings scripts/verify-inspector.mjs",
    "verify:prompt": "node --experimental-strip-types --no-warnings scripts/verify-prompt-techniques.mjs",
    "verify:supabase": "node --env-file-if-exists=.env.local scripts/verify-supabase.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "15.5.4",
    "parse5": "^8.0.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.4",
    "pg": "^8.23.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
